# Eddy registers the app in its launcher. Its implementation lives in the source submodule.
App(
    appid="eddy_spotify",
    name="Spotify",
    apptype=FlipperAppType.MENUEXTERNAL,
    entry_point="eddy_spotify_app",
    requires=["bt"],
    targets=["f7"],
    icon="I_Spotify_16x16",
    order=102,
    stack_size=3072,
    sources=["*.c", "*.cpp"],
    fap_file_assets="source/assets",
    fap_category="assets",
)
